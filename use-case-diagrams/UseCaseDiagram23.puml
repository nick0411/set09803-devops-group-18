@startuml
' SET09803 DevOps Coursework - Requirement 23 Use Case Diagram

left to right direction
skinparam packageStyle rectangle

actor "Demographic Researcher" as Researcher
rectangle "Database System" as DB << System >>

rectangle "World Population Reporting System" {
    usecase "Produce Continent Population Report" as UC_ContinentReport
    usecase "Query Total Population" as UC_QueryTotal
    usecase "Query Urban Population" as UC_QueryUrban
    usecase "Calculate Rural Population" as UC_CalcRural
    usecase "Display Error Message" as UC_Error
}

' Primary Actor Interactions
Researcher --> UC_ContinentReport

' Sub-task dependencies (Includes)
UC_ContinentReport .> UC_QueryTotal : <<include>>
UC_ContinentReport .> UC_QueryUrban : <<include>>
UC_ContinentReport .> UC_CalcRural : <<include>>

' System Actor Interactions
UC_QueryTotal --> DB
UC_QueryUrban --> DB

' Failure Extension
UC_ContinentReport <.. UC_Error : <<extend>>\n(Database Connection\nFailure)

' Notes
note right of UC_ContinentReport
  Generates population report for
  each continent showing:
  - Total Population
  - Urban Population
  - Rural Population
end note

note right of UC_CalcRural
  Rural Population =
  Total Population -
  Urban Population
end note

note bottom of UC_Error
  Triggered if MySQL database
  is unreachable or required
  population data is missing
end note

@enduml