@startuml
left to right direction
skinparam packageStyle rectangle

actor "Data Analyst" as user
actor "Database System" as db <<System>>

rectangle "World Population Reporting System" {
    usecase "Produce Top N Populated Countries in World Report" as UC4
    usecase "Query Country Data" as UC_Query
    usecase "Filter Top N Results" as UC_Filter
    usecase "Sort by Population (Descending)" as UC_Sort
    usecase "Display Error Message" as UC_Error
}

user --> UC4
UC4 .> UC_Query : <<include>>
UC4 .> UC_Filter : <<include>>
UC4 .> UC_Sort : <<include>>
UC4 --> db
UC_Error .> UC4 : <<extend>>
@enduml