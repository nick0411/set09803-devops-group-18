@startuml
left to right direction
skinparam packageStyle rectangle

actor "Data Analyst" as user
actor "Database System" as db <<System>>

rectangle "World Population Reporting System" {
    usecase "Produce Top N Populated Countries in Continent Report" as UC5
    usecase "Query Country Data by Continent" as UC_Query
    usecase "Filter Top N Results" as UC_Filter
    usecase "Sort by Population (Descending)" as UC_Sort
    usecase "Display Error Message" as UC_Error
}

user --> UC5
UC5 .> UC_Query : <<include>>
UC5 .> UC_Filter : <<include>>
UC5 .> UC_Sort : <<include>>
UC5 --> db
UC_Error .> UC5 : <<extend>>
@enduml