@startuml
' SET09803 DevOps Coursework - Requirement 26 Use Case Diagram

left to right direction
skinparam packageStyle rectangle

actor "Data Researcher" as Researcher
rectangle "Database System" as DB << System >>

rectangle "World Population Reporting System" {
    usecase "Retrieve World Population" as UC_WorldPopulation
    usecase "Query Country Population Data" as UC_QueryCountries
    usecase "Calculate Total World Population" as UC_CalcWorld
    usecase "Display Error Message" as UC_Error
}

' Primary Actor Interactions
Researcher --> UC_WorldPopulation

' Sub-task dependencies (Includes)
UC_WorldPopulation .> UC_QueryCountries : <<include>>
UC_WorldPopulation .> UC_CalcWorld : <<include>>

' System Actor Interactions
UC_QueryCountries --> DB

' Failure Extension
UC_WorldPopulation <.. UC_Error : <<extend>>\n(Database Connection\nFailure)

' Notes
note right of UC_WorldPopulation
  Retrieves the total population
  of the world for use as a
  baseline for global statistics
end note

note right of UC_CalcWorld
  World Population =
  Sum of populations
  of all countries
end note

note bottom of UC_Error
  Triggered if MySQL database
  is unreachable or required
  population data is missing
end note

@enduml