@startuml
' SET09803 DevOps Coursework - Requirement 27 Use Case Diagram

left to right direction
skinparam packageStyle rectangle

actor "Data Researcher" as Researcher
rectangle "Database System" as DB << System >>

rectangle "World Population Reporting System" {
    usecase "Retrieve Continent Population" as UC_ContinentPopulation
    usecase "Validate Continent" as UC_ValidateContinent
    usecase "Query Country Population Data" as UC_QueryCountries
    usecase "Calculate Total Continent Population" as UC_CalcContinent
    usecase "Display Error Message" as UC_Error
}

' Primary Actor Interactions
Researcher --> UC_ContinentPopulation

' Sub-task dependencies (Includes)
UC_ContinentPopulation .> UC_ValidateContinent : <<include>>
UC_ContinentPopulation .> UC_QueryCountries : <<include>>
UC_ContinentPopulation .> UC_CalcContinent : <<include>>

' System Actor Interactions
UC_QueryCountries --> DB

' Failure Extensions
UC_ContinentPopulation <.. UC_Error : <<extend>>\n(Invalid Continent or\nDatabase Failure)

' Notes
note right of UC_ContinentPopulation
  Retrieves the total population
  of a selected continent for
  continental-scale analysis
end note

note right of UC_CalcContinent
  Continent Population =
  Sum of populations of all
  countries in the continent
end note

note bottom of UC_Error
  Triggered if the continent
  is invalid, MySQL database
  is unreachable, or required
  population data is missing
end note

@enduml