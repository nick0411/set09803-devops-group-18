@startuml
' SET09803 DevOps Coursework - Use Case 32
' Produce a Report on Global Language Distribution

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Linguistic Researcher" as Researcher
rectangle "Database System" as DB << System >>

rectangle "World Population Reporting System" {
  usecase "Request Global\nLanguage Report" as RequestReport
  usecase "Retrieve Total World\nPopulation" as RetrievePopulation
  usecase "Retrieve Speaker Data for\nChinese, English, Hindi,\nSpanish and Arabic" as RetrieveSpeakers
  usecase "Calculate Speaker Percentages\nof World Population" as CalculatePercentages
  usecase "Sort Languages by\nSpeaker Count" as SortLanguages
  usecase "Display or Export\nLanguage Report" as PresentReport
  usecase "Handle Unavailable\nLanguage Data" as HandleUnavailable
  usecase "Log Data Access Error" as LogError
}

Researcher --> RequestReport
Researcher --> PresentReport

RequestReport .> RetrievePopulation : <<include>>
RequestReport .> RetrieveSpeakers : <<include>>
RequestReport .> CalculatePercentages : <<include>>
RequestReport .> SortLanguages : <<include>>
RequestReport .> PresentReport : <<include>>

RetrievePopulation --> Database
RetrieveSpeakers --> Database

HandleUnavailable .> RetrievePopulation : <<extend>>\n[database unavailable]
HandleUnavailable .> RetrieveSpeakers : <<extend>>\n[data missing or database unavailable]
HandleUnavailable .> LogError : <<include>>
HandleUnavailable --> Researcher : language data unavailable

note right of PresentReport
  Displays Chinese, English, Hindi,
  Spanish and Arabic from greatest
  to smallest speaker count, with each
  language's world-population percentage.
end note

@enduml
